# ============================================================
# Legal Metrology Compliance API — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit your .env file to version control.
# ============================================================

APP_NAME=Legal Metrology Compliance API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Generate a strong random key for production
SECRET_KEY=change-me-in-production

# PostgreSQL connection string
# If your password contains special characters (e.g. @ or %), URL-encode them.
# Example: password "My@Pass" becomes "My%40Pass"
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/legal_metrology

# Comma-separated CORS origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Phase 3 Storage
STORAGE_PATH=storage
MAX_UPLOAD_SIZE_MB=10

# VLM Semantic Declaration Extraction
VLM_PROVIDER=gemini
VLM_MODEL=gemini-3.6-flash
VLM_API_KEY=
EXTRACTOR_MODE=vlm
VLM_FALLBACK_ENABLED=true
VLM_CONFIDENCE_VERIFIED=0.85
VLM_CONFIDENCE_UNCERTAIN=0.60
VLM_TIMEOUT_SECONDS=30
